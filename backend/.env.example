# =====================================================================
# CẤU HÌNH HỆ THỐNG CRM & CHĂM SÓC KHÁCH HÀNG ĐA KÊNH
# =====================================================================

# 1. Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=customer_support_ai

# 2. Flask & Bảo mật Session, JWT Token
SECRET_KEY=super-crm-flask-secret-key-change-in-production
JWT_SECRET=super-crm-omnichannel-jwt-secret-key-32bytes-secure-2026
ALLOWED_WEBCHAT_ORIGINS=*

# 3. AI Providers (Gemini, OpenAI, Mock Fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 4. Google OpenID Connect (OIDC)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Zalo Official Account (OA)
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token
ZALO_APP_ID=your_zalo_app_id
ZALO_SECRET_KEY=your_zalo_secret_key

# 6. Meta (Facebook Messenger & Instagram Direct)
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_VERIFY_TOKEN=crm_facebook_token_2026

# 7. Email Inbound & Outbound
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=support@cskh.vn
IMAP_HOST=imap.gmail.com
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# 8. Tích hợp tra cứu đơn hàng (KiotViet, Sapo, Lazada)
KIOTVIET_CLIENT_ID=your_kiotviet_client_id
KIOTVIET_CLIENT_SECRET=your_kiotviet_client_secret
KIOTVIET_RETAILER=your_retailer_name
SAPO_API_KEY=your_sapo_api_key
SAPO_STORE_DOMAIN=your_store.mysapo.net
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret

# 9. Đơn vị vận chuyển (GHN & GHTK)
GHN_TOKEN=your_ghn_api_token
GHN_WEBHOOK_TOKEN=ghn-crm-secret-token
GHTK_TOKEN=your_ghtk_api_token
GHTK_SECRET_KEY=ghtk-crm-secret-key

# 10. Tổng đài Softphone Twilio Voice
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_API_KEY=SKyour_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=APyour_twiml_app_sid
TWILIO_CALLER_ID=+84901234567
